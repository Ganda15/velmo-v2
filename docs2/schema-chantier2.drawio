        <mxCell id="b_A" value="&lt;b&gt;A. LANCER LE TEST (contrat fourni)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;pytest test_guardrails.py -v&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;5 failed&lt;/font&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;rouge au départ — je ne modifie pas le contrat&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1">
